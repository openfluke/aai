# One layer per run (see ./list-layers.sh). Docker scripts pass layer as first arg.
TEST54_LAYERS=mamba
TEST54_MODES=all
TEST54_DTYPES=all
# Fixed mild LR for deep-stack A/B (override with CSV if you want).
TEST54_LRS=0.05

# Welvet Parallel branch count (1=dense/single, 3=tricameral mid fan-out).
# cam1 :9080  cam3 :9100  (see layer-env.sh — offset from test53's 8080 band)
TEST54_CAMS=1

TEST54_WORKERS=4
TEST54_DURATION=15s
TEST54_LR=0.05
TEST54_HIDDEN=32
# Mid blocks between stem and head (stem + depth mids + head).
TEST54_DEPTH=4
TEST54_CKPT=test54_ckpt
TEST54_CKPT_HOST=
TEST54_RESUME=true
TEST54_TIDE_ADDR=0.0.0.0:8080

GOMEMLIMIT=6GiB
GOGC=50
