# aai ocean — watch remote Tide dashes (no training here).
# Copy to .env and edit (gitignored).

OCEAN_ADDR=0.0.0.0:8090
OCEAN_TITLE=aai ocean
OCEAN_OUT=results

# Comma-separated tide origins (must expose GET /api/board + /api/report).
# Use machine prefix in names for compare page: m4-lo, m5_hi, etc.
TIDE_PEERS=m4-lo=http://192.168.0.22:8080,m5-lo=http://192.168.0.244:8080

# Optional hi peers (same layer, extreme LRs):
# TIDE_PEERS=m4-lo=...,m4-hi=http://192.168.0.22:8082,m5-lo=...,m5-hi=http://192.168.0.244:8082
