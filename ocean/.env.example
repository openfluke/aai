# aai ocean — watch remote Tide dashes (no training here).
# Copy to .env and edit (gitignored).

OCEAN_ADDR=0.0.0.0:8090
OCEAN_TITLE=aai ocean · test54
OCEAN_OUT=results

# test54 ports (offset +1000 from test53):
#   m4 (.22) lo:  cam1 :9080  cam3 :9100
#   m5 (.244) hi: cam1 :9082  cam3 :9102
TIDE_PEERS=cam1-lo=http://192.168.0.22:9080,cam3-lo=http://192.168.0.22:9100,cam1-hi=http://192.168.0.244:9082,cam3-hi=http://192.168.0.244:9102
