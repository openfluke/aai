# aai ocean — watch remote Tide dashes (no training here).
# Copy to .env and edit (gitignored).

OCEAN_ADDR=0.0.0.0:8090
OCEAN_TITLE=aai ocean
OCEAN_OUT=results

# --- Option A: auto cam×band peers (recommended for cam1 vs cam3) ---
TIDE_PEER_HOST=192.168.0.22
TIDE_CAMS=1,3
TIDE_BANDS=lo,hi
# Generates: cam1-lo :8080, cam3-lo :8100, cam1-hi :8082, cam3-hi :8102

# --- Option B: explicit peer list (merged with Option A; explicit names win) ---
# TIDE_PEERS=cam1-lo=http://192.168.0.22:8080,cam3-lo=http://192.168.0.22:8100

# Other machines (m4/m5) can be added to TIDE_PEERS alongside cam auto-peers.
