# aai ocean — watch remote Tide dashes (no training here).
# Copy to .env and edit (gitignored).

OCEAN_ADDR=0.0.0.0:8090
OCEAN_TITLE=aai ocean
OCEAN_OUT=results

# Comma-separated tide origins (must expose GET /api/board + /api/report).
# Use machine prefix in names for compare page: m4-lo, cam3-lo, etc.
TIDE_PEERS=cam1-lo=http://192.168.0.22:8080,cam3-lo=http://192.168.0.22:8100

# Optional hi peers (same layer, extreme LRs):
# TIDE_PEERS=cam1-lo=...,cam1-hi=http://192.168.0.22:8082,cam3-lo=...,cam3-hi=http://192.168.0.22:8102
