# aai ocean — watch remote Tide dashes (no training here).
# Copy to .env and edit (gitignored).

OCEAN_ADDR=0.0.0.0:8090
OCEAN_TITLE=aai ocean
OCEAN_OUT=results

# Split farms across hosts (explicit URLs — don't use TIDE_PEER_HOST when lo/hi are on different boxes):
#   m4 (.22): cam1-lo :8080, cam3-lo :8100
#   m5 (.244): cam1-hi :8082, cam3-hi :8102
TIDE_PEERS=cam1-lo=http://192.168.0.22:8080,cam3-lo=http://192.168.0.22:8100,cam1-hi=http://192.168.0.244:8082,cam3-hi=http://192.168.0.244:8102
