# aai ocean — watch remote Tide dashes (no training here).
# Copy to .env and edit (gitignored).

OCEAN_ADDR=0.0.0.0:8090
OCEAN_TITLE=aai ocean
OCEAN_OUT=results

# Explicit peers (use this when lo/hi/cams live on different machines).
# Example: m4 hosts cam lo farms; m5 hosts hi (and optional lo).
TIDE_PEERS=cam1-lo=http://192.168.0.22:8080,cam3-lo=http://192.168.0.22:8100,m5-lo=http://192.168.0.244:8080,m5-hi=http://192.168.0.244:8082

# --- Optional: auto cam×band on ONE host only ---
# Generates camN-lo/hi on the same IP. Wrong if hi runs on another box.
# TIDE_PEER_HOST=192.168.0.22
# TIDE_CAMS=1,3
# TIDE_BANDS=lo
