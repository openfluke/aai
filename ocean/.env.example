# aai ocean — watch remote Tide dashes (no training here).
# Copy to .env and edit (gitignored).

OCEAN_ADDR=0.0.0.0:8090
OCEAN_TITLE=aai ocean
OCEAN_OUT=results

# Comma-separated tide origins (must expose GET /api/board).
# Optional names: name=url
TIDE_PEERS=m4=http://192.168.0.22:8080,m5_hi=http://192.168.0.244:8082
