# test51 runtime config — copy to .env and edit.
# Existing shell env vars win over this file. CLI flags win over both.
#
# ./start.sh launches ONE PROCESS PER LAYER (own ports + own ckpt folder).
# Press Start on that layer's dash → runs the FULL permute for TEST51_MODES
# on that layer (all dtypes × challenges × funny LRs × cams × grids).

# Which layers to start when you run: ./start.sh
# Options: dense | dense-wide | dense-deep | dense-deep-wide | all
# Or pick interactively: ./start.sh -i
TEST51_LAYERS=dense

# Port bases — layer i uses PORT_BASE+i and TIDE_BASE+i
# dense → :5151 / :8080, dense-wide → :5152 / :8081, …
TEST51_PORT_BASE=5151
TIDE_PORT_BASE=8080

# Checkpoints: each layer → <CKPT_ROOT>/<layer>/
TEST51_CKPT_ROOT=test51_ckpt
TEST51_RUN_DIR=run

# Training modes: all | csv (NormalBP, FastProxy, Sparse, sgd, …)
# Example: NormalBP on dense ⇒ "Start · dense × NormalBP · full permute"
TEST51_MODES=NormalBP

# Full permute (default): all dtypes × all challenges × funny LRs × cams 1-3 × grids 1-3
# Keeps TEST51_MODES + TEST51_LAYERS. Set false to use the shrink axes below.
TEST51_FULL=true

# Only consulted when TEST51_FULL=false:
TEST51_DTYPES=all
TEST51_CHALLENGES=all
TEST51_LRS=funny
TEST51_CAMS=1-3
TEST51_GRIDS=1-3

TEST51_THINK=4
TEST51_DURATION=3s
TEST51_AFTER_FREEZE=2s
TEST51_AFTER_TRAIN=3s
TEST51_PROMOTE=5s
TEST51_WINDOW=1s
TEST51_LR=0.05
TEST51_SEED=1
TEST51_RESUME=true
TEST51_AUTOSTART=false
# TEST51_GAME=
# TEST51_BRIDGE=
# TEST51_JSON=
# TEST51_PERMUTE=false
