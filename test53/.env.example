# Full dayroute LPD matrix — used by go run . and Docker.
TEST53_LAYERS=all
TEST53_MODES=all
TEST53_DTYPES=all
# funny = 0.02,2,200,2000,20000,1m,10m,100m
TEST53_LRS=funny

# Cap workers in Docker / on Mini (0 = NumCPU for native go run).
TEST53_WORKERS=4

TEST53_DURATION=2s
# Only used when TEST53_LRS is empty (single-LR mode).
TEST53_LR=0.05
TEST53_HIDDEN=32
# Host checkpoint dir (native go run). Docker uses TEST53_CKPT_HOST bind mount.
TEST53_CKPT=test53_ckpt
TEST53_CKPT_HOST=
TEST53_RESUME=true
TEST53_TIDE_ADDR=0.0.0.0:8080

GOMEMLIMIT=6GiB
GOGC=50
