# One layer per run (see ./list-layers.sh). Docker scripts pass layer as first arg.
TEST53_LAYERS=dense
TEST53_MODES=all
TEST53_DTYPES=all
# LR presets (TEST53_LRS / -lrs):
#   funny-lo|lo   = 0.02,2,200,2000          (./run-docker-lo.sh)
#   funny-hi|hi   = 20000,1m,10m,100m        (./run-docker-hi.sh)
#   funny|all     = full +ramp (lo+hi)
#   funny-neg|neg = same magnitudes, negative (−100m…−0.02)
#   funny±|pm     = negatives then positives
#   or CSV:       -1m,-0.02,0.02,2,200
TEST53_LRS=funny-lo

# Cap workers in Docker / on Mini (0 = NumCPU for native go run).
TEST53_WORKERS=4

TEST53_DURATION=2s
# Only used when TEST53_LRS is empty (single-LR mode).
TEST53_LR=0.05
TEST53_HIDDEN=32
# Host checkpoint dir (native go run). Docker uses TEST53_CKPT_HOST bind mount.
TEST53_CKPT=test53_ckpt
TEST53_CKPT_HOST=
TEST53_RESUME=true
TEST53_TIDE_ADDR=0.0.0.0:8080

GOMEMLIMIT=6GiB
GOGC=50
