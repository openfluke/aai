# Full dayroute LPD matrix — used by go run . and Docker.
TEST53_LAYERS=all
TEST53_MODES=all
TEST53_DTYPES=all

# Cap workers in Docker / on Mini (0 = NumCPU for native go run).
TEST53_WORKERS=4

TEST53_DURATION=2s
TEST53_LR=0.05
TEST53_HIDDEN=32
TEST53_CKPT=test53_ckpt
TEST53_RESUME=true
TEST53_TIDE_ADDR=0.0.0.0:8080

GOMEMLIMIT=6GiB
GOGC=50
